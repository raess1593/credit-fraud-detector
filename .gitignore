# .venv/
.venv/

# Python bytecode files
__pycache__/
*.pyc

# Environment variables file
.env

# Coverage reports
.coverage

# MLflow artifacts
mlruns/
mlartifacts/

# Data files
*.db

# Terraform state files
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/.terraform/

# Terraform variable files (often contain environment-specific values)
terraform/*.tfvars
terraform/*.tfvars.json
